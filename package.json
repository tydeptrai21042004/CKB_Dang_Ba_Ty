{
  "name": "ckbuilder-passport",
  "version": "8.0.0",
  "private": true,
  "type": "module",
  "description": "CKBuilder v8: CKB agent-service hub, multi-agent launch gate, Fiber dry-run commerce, verifiable job receipts, Mission Control, safe community/MCP plugins, credentials, and BYOK AI.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "env:check": "bash scripts/check-env.sh",
    "issuer:init": "node src/cli/init-issuer.js",
    "credential:mint": "node src/cli/mint-degree.js",
    "credential:verify": "node src/cli/verify-degree.js",
    "credential:revoke": "node src/cli/revoke-degree.js",
    "ledger:reset": "node src/cli/reset-ledger.js",
    "demo": "node src/cli/demo.js",
    "test": "node --test --test-reporter=spec",
    "check": "npm run env:check && npm run learning:check && npm run exercises:run && npm run learning:test && npm test",
    "run:all": "bash scripts/auto-run.sh",
    "project:start": "bash run-full-project.sh",
    "project:fast": "bash run-full-project.sh --fast",
    "project:status": "bash run-full-project.sh --status",
    "project:stop": "bash run-full-project.sh --stop",
    "offckb:configure": "node src/cli/offckb-local.js configure",
    "offckb:create-active": "node src/cli/offckb-local.js create-active",
    "offckb:revoke": "node src/cli/offckb-local.js revoke",
    "offckb:verify": "node src/cli/offckb-local.js verify",
    "offckb:lifecycle": "node src/cli/offckb-local.js lifecycle",
    "local:all": "bash scripts/local-offckb-all.sh",
    "credential:inspect": "node src/cli/public-inspect.js",
    "inspector:serve": "node src/cli/public-inspector-server.js",
    "test:core": "node --test --test-reporter=spec",
    "test:vectors": "node scripts/verify-test-vectors.js",
    "vectors:generate": "node scripts/generate-test-vectors.js",
    "cell:decode": "node src/cli/decode-cell-data.js",
    "proof:verify": "node src/cli/verify-public-proof.js",
    "syntax:check": "bash -c 'while IFS= read -r -d \"\" file; do node --check \"$file\"; done < <(find src test public scripts community -name \"*.js\" -print0)'",
    "community:check": "npm run test:vectors && node --test test/community-vectors.test.js",
    "ci:local": "npm run syntax:check && npm run plugins:check && npm run learning:check && npm run exercises:run && npm run learning:test && npm test && npm run community:check && bash scripts/audit-release.sh",
    "test:rust": "cd digital-credentials-workspace && make test",
    "manifest:export": "node src/cli/export-decoder-manifest.js",
    "inspector:health": "bash scripts/check-inspector-health.sh",
    "learning:check": "node scripts/check-learning.js",
    "learning:check:rust": "node scripts/check-learning.js --require-rust",
    "exercises:run": "node scripts/run-basic-exercises.js",
    "exercises:evidence": "node scripts/run-basic-exercises.js --write-evidence",
    "exercises:test": "node --test --test-reporter=spec test/basic-exercises.test.js test/learning-catalog.test.js",
    "learning:quiz": "node scripts/run-learning-quiz.js",
    "learning:quiz:list": "node scripts/run-learning-quiz.js --list",
    "learning:test": "node --test --test-reporter=spec test/learning-catalog.test.js test/learning-progress.test.js test/learning-quiz.test.js",
    "issuer:serve": "node src/cli/issuer-portal-server.js",
    "prod:check": "node scripts/production-check.js",
    "test:product": "node --test --test-reporter=spec test/product-db.test.js test/session-auth.test.js test/product-http.test.js test/issuer-product.test.js",
    "backup:export": "node src/cli/export-backup.js",
    "test:v4": "node --test --test-reporter=spec test/v4-product.test.js test/v4-http.test.js test/v4-ai.test.js test/v4-webhook.test.js test/v4-issuer.test.js test/v4-ui.test.js test/v4-env.test.js",
    "attachments:audit": "node src/cli/audit-attachments.js",
    "backup:export:full": "node src/cli/export-full-backup.js",
    "test:v5": "node --test --test-reporter=spec test/v5-document.test.js test/v5-http.test.js test/v5-issuer.test.js test/v5-ui.test.js test/v5-storage.test.js",
    "test:ai": "node --test --test-reporter=spec test/v4-ai.test.js test/v5-ai-agents.test.js test/v6-agent-runtime.test.js test/v6-http-ui.test.js test/v4-http.test.js test/v7-application-service.test.js test/v7-plugin-runtime.test.js test/v7-http-ui.test.js test/v8-agent-commerce.test.js test/v8-http-ui.test.js",
    "test:v6": "node --test --test-reporter=spec test/v6-agent-runtime.test.js test/v6-http-ui.test.js",
    "plugins:check": "node scripts/check-ai-plugins.js",
    "test:v7": "node --test --test-reporter=spec test/v7-application-service.test.js test/v7-plugin-runtime.test.js test/v7-http-ui.test.js",
    "test:v8": "node --test --test-reporter=spec test/v8-agent-commerce.test.js test/v8-http-ui.test.js"
  },
  "dependencies": {
    "@ckb-ccc/core": "1.16.1"
  },
  "devDependencies": {
    "@offckb/cli": "0.4.8"
  }
}
