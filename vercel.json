{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "vercel-entry.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "{public,data,deployment,learning,plugins,community}/**"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/vercel-entry.js"
    }
  ]
}
