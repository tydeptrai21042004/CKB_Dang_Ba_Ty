{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "vercel-entry.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "{public/**,data/ledger.json,data/trusted-issuers.json,data/offckb-chain-state.json,deployment/*.json,learning/**,plugins/**,community/**}"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/vercel-entry.js"
    }
  ],
  "installCommand": "npm ci --omit=dev"
}
